# =============================================================================
# Noether — example environment. Copy to .env and edit for your local stack.
# Per SPEC section 7: defaults must run air-gapped with zero paid services.
# =============================================================================

# --- Global ----------------------------------------------------------------
# OFFLINE_MODE=1 enforces no external DNS lookups beyond infra brokers.
OFFLINE_MODE=1
LOG_LEVEL=info

# --- LLM backend ----------------------------------------------------------
# Air-gap default: Ollama. Two ways to reach it:
#   1) Dockerized (zero host setup): OLLAMA_HOST=http://ollama:11434
#      The compose `agent` profile starts an Ollama container — pull a
#      model into it once with:
#          docker exec -it noether-ollama ollama pull llama3.2:3b
#   2) Host Ollama (e.g. Fedora systemd unit at port 11434): set
#          OLLAMA_HOST=http://host.docker.internal:11434
#      and optionally `docker compose ... --scale ollama=0` to skip the
#      dockerized container. The agent service has the host-gateway
#      alias declared, so this works on both Docker Desktop and Linux.
LLM_BACKEND=ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
# Optional cloud fallbacks (kept for the OpenSpec change that wires
# them up properly — leave empty in default air-gapped mode).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Agent service --------------------------------------------------------
AGENT_HOST=0.0.0.0
AGENT_PORT=8100
AGENT_API_KEY=changeme-please
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-please

# --- Kafka / Redpanda -----------------------------------------------------
KAFKA_BOOTSTRAP=redpanda:9092
KAFKA_TOPIC_PLANT_TAGS=plant.tags

# --- TimescaleDB ----------------------------------------------------------
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=noether
POSTGRES_USER=noether
POSTGRES_PASSWORD=noether
RETENTION_DAYS=90

# --- Ingest service -------------------------------------------------------
REPLAY_HZ=1.0
SIM_SEED=42
FAULT_PROFILE=none
FAULT_START_S=0

# --- Inference service ----------------------------------------------------
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8000
FORECAST_HORIZON_MIN=30
MODEL_DIR=/app/models
INFERENCE_API_KEY=changeme-please

# --- Observability --------------------------------------------------------
# Worker services have no HTTP framework, so they expose the Prometheus
# default registry on a dedicated side port. FastAPI services (inference,
# agent) serve /metrics on their app port instead. Prometheus scrapes all
# of these via the compose-network service DNS (see infra/prometheus).
INGEST_METRICS_PORT=9101
STORAGE_METRICS_PORT=9102
ANOMALY_METRICS_PORT=9103

# --- MLflow ---------------------------------------------------------------
# Tracking server (compose `agent`/`eval` profiles). Backend store is a
# dedicated `mlflow` database on the shared Timescale Postgres; artefacts
# live on the mlflow-artifacts volume. Training / eval code points at the
# server via MLFLOW_TRACKING_URI.
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Grafana --------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
