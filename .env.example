# =============================================================================
# Noether — example environment. Copy to .env and edit for your local stack.
# Per SPEC section 7: defaults must run air-gapped with zero paid services.
# =============================================================================

# --- Global ----------------------------------------------------------------
# OFFLINE_MODE=1 enforces no external DNS lookups beyond infra brokers.
OFFLINE_MODE=1
LOG_LEVEL=info

# --- LLM backend (used in later milestones) -------------------------------
LLM_BACKEND=ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.3
# Optional cloud fallbacks — leave empty in default mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Kafka / Redpanda -----------------------------------------------------
KAFKA_BOOTSTRAP=redpanda:9092
KAFKA_TOPIC_PLANT_TAGS=plant.tags

# --- TimescaleDB ----------------------------------------------------------
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=noether
POSTGRES_USER=noether
POSTGRES_PASSWORD=noether
RETENTION_DAYS=90

# --- Ingest service -------------------------------------------------------
REPLAY_HZ=1.0
SIM_SEED=42
FAULT_PROFILE=none
FAULT_START_S=0

# --- Inference service ----------------------------------------------------
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8000
FORECAST_HORIZON_MIN=30
MODEL_DIR=/app/models
INFERENCE_API_KEY=changeme-please

# --- Grafana --------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
