# Default: let git auto-detect text and normalize to LF in the repo.
* text=auto eol=lf

# Files that MUST be LF in the working tree (they break with CRLF inside Linux containers / shells)
*.sh         text eol=lf
*.bash       text eol=lf
Dockerfile*  text eol=lf
Makefile     text eol=lf
*.mk         text eol=lf

# Always LF — these are read by tools that prefer LF.
*.py         text eol=lf
*.toml       text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.lock       text eol=lf
.env*        text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.svg        text eol=lf
*.pdf        binary
*.zip        binary
*.gz         binary
*.lgbm       binary
*.pkl        binary
*.joblib     binary
*.ckpt       binary
*.pt         binary
*.onnx       binary
