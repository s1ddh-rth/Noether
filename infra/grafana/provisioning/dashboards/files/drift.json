{
  "title": "Noether — Input Drift",
  "uid": "noether-drift",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Latest verdict",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "No drift", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "DRIFT", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT dataset_drift::int AS verdict FROM drift_reports ORDER BY ts DESC LIMIT 1"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latest drift share",
      "type": "gauge",
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 0.3 },
            { "color": "red", "value": 0.5 }
          ] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT drift_share FROM drift_reports ORDER BY ts DESC LIMIT 1"
        }
      ]
    },
    {
      "id": 3,
      "title": "Drifted features (latest)",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT n_drifted, n_features FROM drift_reports ORDER BY ts DESC LIMIT 1"
        }
      ]
    },
    {
      "id": 4,
      "title": "Drift share over time",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": { "min": 0, "max": 1, "unit": "percentunit" }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, drift_share FROM drift_reports WHERE $__timeFilter(ts) ORDER BY ts"
        }
      ]
    },
    {
      "id": 5,
      "title": "Recent drift runs",
      "type": "table",
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts, status, dataset_drift, n_drifted, n_features, round(drift_share::numeric, 3) AS drift_share FROM drift_reports WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 50"
        }
      ]
    }
  ]
}
